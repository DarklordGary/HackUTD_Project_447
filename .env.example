# Nemotron runs server-side; do not prefix these values with VITE_.
NEMOTRON_BASE_URL=https://5000-19yyxh1ah.gobrev.dev/v1
NEMOTRON_API_KEY=EMPTY
NEMOTRON_MODEL=nemotron
# Keep interactive tool calls fast; set true to enable reasoning for the agent.
NEMOTRON_ENABLE_THINKING=false

# Leave the database unset to save the workspace on this device.
# After publishing the module, use its database name here.
VITE_SPACETIMEDB_URI=ws://127.0.0.1:3000
VITE_SPACETIMEDB_DATABASE=
