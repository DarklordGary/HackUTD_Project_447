# Nemotron runs server-side. Never prefix the API key with VITE_.
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Leave unset for the fully functional device-persistent demo.
# After publishing the module, use its database name here.
VITE_SPACETIMEDB_URI=ws://127.0.0.1:3000
VITE_SPACETIMEDB_DATABASE=
